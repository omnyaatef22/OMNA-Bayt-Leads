    {
      "parameters": {
        "jsCode": "// Decide, per lead, what is due now: a WhatsApp follow-up (day 1, 3, 7), a call reminder for sales, or an escalation.\nconst now = $now.setZone('Africa/Cairo');\nif (now.hour < 9 || now.hour >= 21) return []; // never message people at night\nconst STEP_DAYS = [1, 3, 7];\nconst parse = s => DateTime.fromFormat(String(s || ''), 'yyyy-MM-dd HH:mm', { zone: 'Africa/Cairo' });\nconst out = [];\nfor (const { json: l } of $input.all()) {\n  if (!l.lead_id || ['won', 'lost', 'viewing_booked', 'escalated'].includes(l.status)) continue;\n  const created = parse(l.created_at); const sent = Number(l.followups_sent || 0);\n  if (l.tier === 'hot' && l.status === 'new' && created.isValid && now.diff(created, 'minutes').minutes > 15) {\n    out.push({ json: { action: 'escalate', lead: l, text: '🔥 Hot lead untouched for 15+ minutes: ' + l.lead_id + ' · ' + l.name + ' · ' + l.phone + ' · budget ' + l.budget_egp + ' EGP · ' + l.area } });\n    continue;\n  }\n  const due = parse(l.next_followup);\n  if (!due.isValid || due > now || sent >= STEP_DAYS.length) continue;\n  const next = sent + 1 < STEP_DAYS.length ? created.plus({ days: STEP_DAYS[sent + 1] }).toFormat('yyyy-MM-dd HH:mm') : '';\n  const msgs = ['Hi ' + (l.name || '') + ', this is Bayt Real Estate. Did you get a chance to look at the units we sent? Reply 1 to book a viewing.',\n    'Hi ' + (l.name || '') + ', new units in ' + (l.area || 'your area') + ' just came in within your budget. Want us to send them?',\n    'Hi ' + (l.name || '') + ', last check-in from Bayt. If you are still looking, reply and an advisor will call you today.'];\n  out.push({ json: { action: l.source === 'whatsapp' ? 'whatsapp' : 'call_reminder', lead: l, step: sent + 1, next_followup: next,\n    text: l.source === 'whatsapp' ? msgs[sent] : '📞 Follow-up #' + (sent + 1) + ' due: call ' + l.name + ' (' + l.phone + ') · ' + l.lead_id + ' · ' + l.tier } });\n}\nreturn out;"
      },
